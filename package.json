{
  "name": "@agledger/verify-core",
  "version": "2.1.0",
  "description": "Shared offline verification core for AGLedger audit chains: COSE_Sign1 (RFC 9052), Ed25519 and ES256, hash-chain walk, key-statement trust walk, RFC 9162 Merkle proofs, canonical failure taxonomy. One dependency (cborg); no network.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "deps:lag": "node scripts/dep-lag.mjs",
    "deps:refresh": "npm update && node scripts/dep-lag.mjs",
    "lint:pkg": "publint --strict && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution",
    "prepublishOnly": "npm run build && npm run lint:pkg"
  },
  "dependencies": {
    "cborg": "6.1.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@types/node": "^24.13.3",
    "publint": "^0.3.22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agledger-ai/verify-core.git"
  },
  "bugs": {
    "url": "https://github.com/agledger-ai/verify-core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://agledger.ai",
  "author": "AGLedger LLC"
}
